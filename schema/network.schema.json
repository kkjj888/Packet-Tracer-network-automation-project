{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/network.schema.json",
  "title": "Packet Tracer Network DSL",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "devices", "links"],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "ipv4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ipv4_interface"
      }
    },
    "vlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan"
      }
    },
    "vlan_assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan_assignment"
      }
    },
    "switch_routing": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "svis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/svi"
      }
    },
    "hsrp": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hsrp_group"
      }
    },
    "stp": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stp_config"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/static_route"
          }
        },
        "rip": {
          "$ref": "#/$defs/rip"
        },
        "ospf": {
          "$ref": "#/$defs/ospf"
        },
        "bgp": {
          "$ref": "#/$defs/bgp"
        },
        "tunnels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gre_tunnel"
          }
        }
      }
    },
    "dhcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dhcp_pool"
          }
        }
      }
    },
    "dhcp_clients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dhcp_client"
      }
    },
    "nat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pat": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nat_pat"
          }
        },
        "static": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nat_static"
          }
        }
      }
    },
    "link_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link_failure"
      }
    },
    "acls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acl"
      }
    },
    "acl_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acl_binding"
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "domain_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]{1,80}$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64
        },
        "access_acl": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        }
      }
    },
    "wireless": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssid", "access_point", "clients"],
      "properties": {
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "access_point": {
          "$ref": "#/$defs/identifier"
        },
        "encryption": {
          "enum": ["open", "wpa2-psk"]
        },
        "passphrase": {
          "type": "string",
          "minLength": 8,
          "maxLength": 63
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectivity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectivity_test"
          }
        },
        "route_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route_assertion"
          }
        },
        "traceroute_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceroute_test"
          }
        },
        "device_output_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_assertion"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}:[A-Za-z0-9/._ -]+$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "model"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "router",
            "switch",
            "multilayer_switch",
            "pc",
            "server",
            "laptop",
            "access_point"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "x": {
          "type": "integer",
          "minimum": 20,
          "maximum": 4000
        },
        "y": {
          "type": "integer",
          "minimum": 20,
          "maximum": 3000
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "slot"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "slot": {
                "type": "string",
                "pattern": "^[0-9]+(?:/[0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "cable": {
          "enum": [
            "copper-straight",
            "copper-cross",
            "fiber",
            "console",
            "serial"
          ]
        }
      }
    },
    "ipv4_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "address"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "parent_port": {
          "type": "string",
          "minLength": 1
        },
        "dot1q_vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "point_to_point": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["parent_port"]
          },
          "then": {
            "required": ["dot1q_vlan"]
          }
        },
        {
          "if": {
            "required": ["dot1q_vlan"]
          },
          "then": {
            "required": ["parent_port"]
          }
        }
      ]
    },
    "vlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        }
      }
    },
    "vlan_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "mode"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["access", "trunk"]
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "native_vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "allowed_vlans": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          },
          "uniqueItems": true
        }
      }
    },
    "svi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "vlan", "address"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "address": {
          "$ref": "#/$defs/ipv4_cidr"
        }
      }
    },
    "hsrp_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "vlan", "group", "virtual_ip"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "virtual_ip": {
          "$ref": "#/$defs/ipv4"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "preempt": {
          "type": "boolean"
        },
        "track_port": {
          "type": "string",
          "minLength": 1
        },
        "track_decrement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "stp_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "role", "vlans"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "enum": ["primary", "secondary", "priority"]
        },
        "vlans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 61440,
          "multipleOf": 4096
        }
      }
    },
    "static_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "network", "next_hop"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "network": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "next_hop": {
          "$ref": "#/$defs/ipv4"
        },
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "admin_distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "rip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "devices", "networks"],
      "properties": {
        "version": {
          "enum": [1, 2]
        },
        "auto_summary": {
          "type": "boolean"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      }
    },
    "ospf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_id", "devices", "networks"],
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "router_id": {
          "$ref": "#/$defs/ipv4"
        },
        "default_information_originate": {
          "type": "boolean"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device"],
            "properties": {
              "device": {
                "$ref": "#/$defs/identifier"
              },
              "router_id": {
                "$ref": "#/$defs/ipv4"
              },
              "passive_interfaces": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "point_to_point_interfaces": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "default_information_originate": {
                "type": "boolean"
              }
            }
          }
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "network", "area"],
            "properties": {
              "device": {
                "$ref": "#/$defs/identifier"
              },
              "network": {
                "$ref": "#/$defs/ipv4_cidr"
              },
              "area": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "passive": {
                "type": "boolean"
              },
              "point_to_point": {
                "type": "boolean"
              }
            }
          }
        },
        "area_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "area", "network"],
            "properties": {
              "device": {
                "$ref": "#/$defs/identifier"
              },
              "area": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "network": {
                "$ref": "#/$defs/ipv4_cidr"
              }
            }
          }
        }
      }
    },
    "bgp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices"],
      "properties": {
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "local_as"],
            "properties": {
              "device": {
                "$ref": "#/$defs/identifier"
              },
              "local_as": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "router_id": {
                "$ref": "#/$defs/ipv4"
              },
              "neighbors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["address", "remote_as"],
                  "properties": {
                    "address": {
                      "$ref": "#/$defs/ipv4"
                    },
                    "remote_as": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    }
                  }
                }
              },
              "networks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ipv4_cidr"
                }
              }
            }
          }
        }
      }
    },
    "gre_tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "interface",
        "address",
        "source",
        "destination"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "interface": {
          "type": "string",
          "pattern": "^Tunnel[0-9]+$"
        },
        "address": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "$ref": "#/$defs/ipv4"
        },
        "mtu": {
          "type": "integer",
          "minimum": 576,
          "maximum": 1500
        }
      }
    },
    "acl_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["permit", "deny"]
        },
        "match": {
          "enum": ["any", "host", "network"]
        },
        "address": {
          "$ref": "#/$defs/ipv4"
        },
        "wildcard": {
          "$ref": "#/$defs/ipv4"
        },
        "protocol": {
          "enum": ["ip", "tcp", "udp", "icmp"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["any", "host", "network"]
            },
            "address": {
              "$ref": "#/$defs/ipv4"
            },
            "wildcard": {
              "$ref": "#/$defs/ipv4"
            }
          },
          "required": ["kind"]
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["any", "host", "network"]
            },
            "address": {
              "$ref": "#/$defs/ipv4"
            },
            "wildcard": {
              "$ref": "#/$defs/ipv4"
            }
          },
          "required": ["kind"]
        },
        "source_port_eq": {
          "$ref": "#/$defs/port_or_name"
        },
        "destination_port_eq": {
          "$ref": "#/$defs/port_or_name"
        },
        "icmp_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "established": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "host"
              }
            },
            "required": ["match"]
          },
          "then": {
            "required": ["address"]
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "network"
              }
            },
            "required": ["match"]
          },
          "then": {
            "required": ["address", "wildcard"]
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "tcp"
              }
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["source", "destination"]
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "udp"
              }
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["source", "destination"]
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "ip"
              }
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["source", "destination"]
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "icmp"
              }
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["source", "destination"]
          }
        }
      ]
    },
    "port_or_name": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "enum": [
            "bootpc",
            "bootps",
            "domain",
            "www",
            "https",
            "ssh",
            "telnet",
            "ftp",
            "smtp"
          ]
        }
      ]
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "kind": {
          "enum": ["standard", "extended"]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acl_rule"
          }
        }
      }
    },
    "acl_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "acl", "direction"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "acl": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["in", "out"]
        }
      }
    },
    "connectivity_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "destination", "expected"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "destination": {
          "$ref": "#/$defs/identifier"
        },
        "expected": {
          "enum": ["pass", "fail"]
        },
        "protocol": {
          "const": "ping"
        }
      }
    },
    "route_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "destination", "protocol"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "destination": {
