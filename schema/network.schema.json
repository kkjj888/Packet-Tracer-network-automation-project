{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/network.schema.json",
  "title": "Packet Tracer Network DSL",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "devices", "links"],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "ipv4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ipv4_interface"
      }
    },
    "vlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan"
      }
    },
    "vlan_assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan_assignment"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/static_route"
          }
        },
        "rip": {
          "$ref": "#/$defs/rip"
        },
        "ospf": {
          "$ref": "#/$defs/ospf"
        }
      }
    },
    "acls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acl"
      }
    },
    "acl_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acl_binding"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectivity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectivity_test"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}:[A-Za-z0-9/._-]+$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "model"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": ["router", "switch", "pc", "server"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "cable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ipv4_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "address"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "parent_port": {
          "type": "string",
          "minLength": 1
        },
        "dot1q_vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["parent_port"]
          },
          "then": {
            "required": ["dot1q_vlan"]
          }
        },
        {
          "if": {
            "required": ["dot1q_vlan"]
          },
          "then": {
            "required": ["parent_port"]
          }
        }
      ]
    },
    "vlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        }
      }
    },
    "vlan_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "mode"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["access", "trunk"]
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "native_vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "allowed_vlans": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          },
          "uniqueItems": true
        }
      }
    },
    "static_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "network", "next_hop"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "network": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "next_hop": {
          "$ref": "#/$defs/ipv4"
        },
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "admin_distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "rip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "devices", "networks"],
      "properties": {
        "version": {
          "enum": [1, 2]
        },
        "auto_summary": {
          "type": "boolean"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      }
    },
    "ospf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_id", "devices", "networks"],
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "network", "area"],
            "properties": {
              "device": {
                "$ref": "#/$defs/identifier"
              },
              "network": {
                "$ref": "#/$defs/ipv4_cidr"
              },
              "area": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    },
    "acl_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "match"],
      "properties": {
        "action": {
          "enum": ["permit", "deny"]
        },
        "match": {
          "enum": ["any", "host", "network"]
        },
        "address": {
          "$ref": "#/$defs/ipv4"
        },
        "wildcard": {
          "$ref": "#/$defs/ipv4"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "host"
              }
            }
          },
          "then": {
            "required": ["address"]
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "network"
              }
            }
          },
          "then": {
            "required": ["address", "wildcard"]
          }
        }
      ]
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acl_rule"
          }
        }
      }
    },
    "acl_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "port", "acl", "direction"],
      "properties": {
        "device": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "acl": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["in", "out"]
        }
      }
    },
    "connectivity_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "destination", "expected"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "destination": {
          "$ref": "#/$defs/identifier"
        },
        "expected": {
          "enum": ["pass", "fail"]
        },
        "protocol": {
          "const": "ping"
        }
      }
    }
  }
}
